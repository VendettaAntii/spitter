"VertexlitGeneric"
{
	"$basetexture" 					"models\survivors\chunli\Hair_D"
	"$bumpmap" 						"models\survivors\chunli\bile_normal"
	"$phongexponenttexture" 		"dev/reflectivity_90b"
	
	"$phong" 						"1"
	"$phongboost"					"12"
	"$phongfresnelranges"			"[1 2 6]"
	"$phongexponent"		"34"
	"$phongalbedotint"		"1"

	"$envmap" 						"env_cubemap"
	"$normalmapalphaenvmapmask"		"1"
	//"$envmapfresnel"				"1"
	"$envmaptint"					"[.09 .05 .024]"
	
	$bussin   12
	
	$detail "models\survivors\chunli\bile"
	$detailscale 1.85
	$detailblendfactor ".001" 
	$detailblendmode 0

	$ITAmount 0
 

	Proxies
	{
		IT
		{
			resultVar $ITAmount
		}
		Equals
		{
			srcVar1 $ITAmount
			resultVar $detailblendfactor
		}
		Multiply
		{
			srcVar1	$bussin
			srcVar2	$ITAmount
			resultVar	$phongboost
		}
	}
}

